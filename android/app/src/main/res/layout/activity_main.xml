<?xml version="1.0" encoding="utf-8"?>
<!--
  The root carries the dark "ink" colour so that the window insets we pad it with
  (status bar, navigation bar, display cutout) read as a deliberate chrome around
  the light page rather than as empty space.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/page_background" />

</FrameLayout>
